                  "description": "(Required) Comma-separated recipient phone numbers in international format."
                },
                {
                  "disabled": false,
                  "key": "message",
                  "value": "<string>",
                  "description": "(Required) The message body to send."
                },
                {
                  "disabled": false,
                  "key": "from",
                  "value": "<string>",
                  "description": "Registered short code or alphanumeric sender ID."
                },
                {
                  "disabled": false,
                  "key": "bulkSMSMode",
