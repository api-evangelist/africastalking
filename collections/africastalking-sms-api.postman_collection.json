                  "description": "Set to 1 to enable bulk SMS delivery."
                },
                {
                  "disabled": false,
                  "key": "enqueue",
                  "value": "<integer>",
                  "description": "Set to 1 to enqueue large outbound batches."
                },
                {
                  "disabled": false,
                  "key": "keyword",
