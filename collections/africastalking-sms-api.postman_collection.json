                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "disabled": false,
                  "key": "username",
                  "value": "<string>",
                  "description": "(Required) Your Africa's Talking application username."
                },
                {
                  "disabled": false,
